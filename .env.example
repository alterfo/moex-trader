# Copy to .env and fill in. .env is gitignored — never commit real values.
# Every variable below is read by name only; configs store the variable name,
# the value is resolved at startup (see internal/config).

# --- T-Bank (T-Invest) ---
# Sandbox token from https://www.tbank.ru/invest/settings/api/
MOEX_TRADER_TINKOFF_TOKEN=
# Optional: pin an existing T-Bank sandbox account id (empty = reuse/create).
MOEX_TRADER_TINKOFF_ACCOUNT_ID=

# --- Telegram alerts ---
# Bot token from @BotFather; chat id of the target chat.
MOEX_TRADER_TELEGRAM_BOT_TOKEN=
MOEX_TRADER_TELEGRAM_CHAT_ID=

# --- Finam (optional) ---
# MOEX_TRADER_FINAM_SECRET_TOKEN=

# --- MOEX AlgoPack (optional; enrichment silently disables when unset) ---
# MOEX_TRADER_ALGOPACK_TOKEN=

# --- Failover / witness (watchdog.env on the trading nodes) ---
# Shared secrets between the nodes and the VPS witness. Generate with:
#   openssl rand -hex 32
MOEX_WITNESS_TOKEN=
MOEX_FAILOVER_TOKEN=
